# .gitignore – IoT Sensor Data Pipeline

# Environment & secrets
.env
*.env.local

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg
*.whl

# Virtual environments
venv/
.venv/
env/
ENV/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.pytest_cache

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Airflow
logs/
plugins/

# Data files (generated at runtime)
data/*.csv

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
