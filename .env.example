# =============================================================================
# .env.example
# Environment variable template for the IoT Sensor Data Pipeline.
#
# INSTRUCTIONS:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in the values below with your actual credentials.
#   3. NEVER commit the .env file to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Apache Airflow metadata database (PostgreSQL – managed by Docker Compose)
# ---------------------------------------------------------------------------
# Credentials for the Airflow internal metadata database.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow_secret_password_change_me

# ---------------------------------------------------------------------------
# IoT Sensor Data Warehouse (separate PostgreSQL instance)
# ---------------------------------------------------------------------------
# Target database where raw and processed sensor data is stored.
DW_USER=iot_user
DW_PASSWORD=iot_secret_password_change_me
DW_DB=iot_sensors

# ---------------------------------------------------------------------------
# Apache Airflow general settings
# ---------------------------------------------------------------------------
# Unique ID for your Airflow user (Linux UID). Run `id -u` to find yours.
# On Windows / macOS leave this as 50000.
AIRFLOW_UID=50000

# Fernet key for encrypting sensitive data (connections, variables) at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here_change_me

# ---------------------------------------------------------------------------
# Airflow web UI admin credentials (used by airflow-init on first run)
# ---------------------------------------------------------------------------
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin_password_change_me

# ---------------------------------------------------------------------------
# Sensor data generation
# ---------------------------------------------------------------------------
# Number of sensor readings per DAG run batch (100–500).
SENSOR_BATCH_SIZE=250

# ---------------------------------------------------------------------------
# Airflow connection ID used by the DAG (must match docker-compose env var)
# ---------------------------------------------------------------------------
DW_CONN_ID=data_warehouse_postgres
